{
  "software": [
    {
      "name": "Docker",
      "version": "19.03",
      "installationSteps": {
        "Astra": [
          {
            "type": "skipCondition",
            "value": "docker --version"
          },
          {
            "type": "command",
            "value": "export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get -o Dpkg::Options::=\"--force-confold\" upgrade -q -y --force-yes && apt-get -o Dpkg::Options::=\"--force-confold\" dist-upgrade -q -y --force-yes"
          },
          {
            "type": "packages",
            "value": "selinux-utils, apt-transport-https, ca-certificates, curl, gnupg-agent, software-properties-common, lsb-release"
          },
          {
            "type": "comment",
            "value": "Using Debian repository for Astra Linux (Debian-based)"
          },
          {
            "type": "command",
            "value": "curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg"
          },
          {
            "type": "command",
            "value": "echo \"deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian buster stable\" > /etc/apt/sources.list.d/docker.list"
          },
          {
            "type": "command",
            "value": "apt-get update"
          },
          {
            "type": "packages",
            "value": "docker-ce, docker-ce-cli, containerd.io, telnet"
          },
          {
            "type": "command",
            "value": "docker login -u '{{DOCKER.LOGIN.ACCOUNT}}' -p '{{DOCKER.LOGIN.PASSWORD}}'"
          },
          {
            "type": "command",
            "value": "sh {{SERVER.UTILS_HOME}}/docker_configuration_proxy_init.sh {{PROXY.HOST}} {{PROXY.PORT}} {{PROXY.ACCOUNT}} {{PROXY.PASSWORD}} true"
          },
          {
            "type": "reboot",
            "value": "480"
          },
          {
            "type": "command",
            "value": "docker run --rm hello-world"
          }
        ]
      }
    }
  ]
}
